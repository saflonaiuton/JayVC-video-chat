# Supabase public project settings (SUPABASE_ANON_KEY is safe for browser use).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Server-only secrets. Save as Replit Secrets; never add real values here.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
DAILY_API_KEY=your-server-only-daily-api-key
TURNSTILE_SECRET_KEY=your-server-only-turnstile-secret

# Public CAPTCHA widget key; safe to expose to the browser.
TURNSTILE_SITE_KEY=your-public-turnstile-site-key

# Development/test reference only. Production matches always create a distinct
# private room and must never send all visitors to this fixed room.
DAILY_TEST_ROOM_URL=https://jaybc.daily.co/jayvc
